# Vorlage für deploy/ionos/.env. Am einfachsten legt ./einrichten.sh die .env an und erzeugt die
# Geheimnisse selbst. Die .env nie einchecken, nie in Chats oder Mails kopieren.

# Domain, die auf die IP des Servers zeigt (A-Record bei IONOS), z. B. praxis.example.at
LUMIVA_DOMAIN=

# Geheimnisse. Leer lassen: ./einrichten.sh erzeugt sie beim ersten Start.
# Das Datenbank-Passwort nur aus Hex-Zeichen (openssl rand -hex 32), es steht in einer URL.
POSTGRES_PASSWORT=
# 32 Bytes, base64 (openssl rand -base64 32). Ohne diesen Schlüssel sind alle Akten unlesbar,
# auch aus jedem Backup: getrennt vom Server sichern (Passwortmanager und Ausdruck im Safe).
LUMIVA_HAUPTSCHLUESSEL=
BETTER_AUTH_SECRET=

# KI für die Dokumentation (Diktat, Sitzungsaufnahme), läuft auf diesem Server.
# Aus (Standard). Einschalten: COMPOSE_PROFILES=ki, braucht etwa 8 vCPU und 32 GB RAM.
COMPOSE_PROFILES=
# medium ist ein guter Kompromiss auf CPU; Systran/faster-whisper-large-v3 ist genauer, aber langsamer.
WHISPER_MODELL=Systran/faster-whisper-medium
SPRACHMODELL=qwen2.5:7b-instruct

# Backups (siehe README, Abschnitt Backups).
# Öffentlicher age-Schlüssel (beginnt mit age1…). Der private Schlüssel liegt NICHT auf dem Server.
SICHERUNG_EMPFAENGER=
# Ziel außer Haus als rclone-Ziel, z. B. ionos-s3:lumiva-sicherung. Leer: nur lokal.
SICHERUNG_ZIEL=
# Wie viele Tage die Backups auf dem Server bleiben (außer Haus regelt das die Lebenszyklus-Regel des Buckets).
SICHERUNG_TAGE=14
