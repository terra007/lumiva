# Kopieren nach deploy/ionos/.env und ausfüllen. Die .env nie einchecken und sicher sichern.

# Domain, die auf die IP des Servers zeigt (A-Record bei IONOS), z. B. praxis.example.at
LUMIVA_DOMAIN=

# Zufällige Werte erzeugen mit: openssl rand -base64 32
POSTGRES_PASSWORT=
# Ohne diesen Schlüssel sind alle Akten unlesbar: getrennt vom Server sichern!
LUMIVA_HAUPTSCHLUESSEL=
BETTER_AUTH_SECRET=

# KI-Modelle (frei). medium ist ein guter Kompromiss auf CPU; large-v3 ist genauer, aber langsamer.
WHISPER_MODELL=Systran/faster-whisper-medium
SPRACHMODELL=qwen2.5:7b-instruct
