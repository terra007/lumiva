# Verbindung zur PostgreSQL-Datenbank (in der EU gehostet)
DATABASE_URL=postgres://lumiva:lumiva@localhost:5432/lumiva

# Hauptschlüssel für die Feldverschlüsselung: 32 Bytes, base64.
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nie einchecken, nie wiederverwenden, sicher sichern: ohne ihn sind alle Akten unlesbar.
LUMIVA_HAUPTSCHLUESSEL=
